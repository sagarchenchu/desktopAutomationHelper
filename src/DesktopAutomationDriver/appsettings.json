{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FailureScreenshotDirectory": "test/resources",
  "Vision": {
    "Enabled": false,
    "AllowWhenUiaInaccessible": true,
    "AllowWhenPolicyPermits": false,
    "MaxScreenshotAgeMilliseconds": 1500,
    "CandidateTtlMilliseconds": 300000,
    "ExecutionTokenTtlMilliseconds": 30000,
    "MaxStoredCandidates": 64,
    "PersistSensitiveScreenshots": false,
    "RedactSensitiveText": true,
    "Provider": "fake",
    "MinimumConfidence": 0.6
  }
}
