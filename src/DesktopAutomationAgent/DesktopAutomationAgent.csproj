<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DesktopAutomationAgent</RootNamespace>
    <AssemblyName>DesktopAutomationAgent</AssemblyName>
    <Description>Project-specific desktop testing agent that talks to DesktopAutomationDriver over HTTP.</Description>
    <!-- Local/dev default. Release and CI publish override Version/InformationalVersion (1.0.run_number). -->
    <Version>0.0.0-local</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Gherkin" Version="30.1.2" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\automation\schemas\exploration-policy.schema.json" LogicalName="DesktopAutomationAgent.Exploration.exploration-policy.schema.json" />
    <EmbeddedResource Include="..\..\automation\schemas\application-knowledge.schema.json" LogicalName="DesktopAutomationAgent.Knowledge.application-knowledge.schema.json" />
    <EmbeddedResource Include="..\..\automation\schemas\application-state-graph.schema.json" LogicalName="DesktopAutomationAgent.Knowledge.application-state-graph.schema.json" />
    <EmbeddedResource Include="..\..\automation\schemas\application-workflow.schema.json" LogicalName="DesktopAutomationAgent.Knowledge.application-workflow.schema.json" />
    <EmbeddedResource Include="..\..\automation\schemas\knowledge-approval.schema.json" LogicalName="DesktopAutomationAgent.Knowledge.knowledge-approval.schema.json" />
    <EmbeddedResource Include="..\..\automation\schemas\jira-test-case.schema.json" LogicalName="DesktopAutomationAgent.Compilation.jira-test-case.schema.json" />
    <EmbeddedResource Include="..\..\automation\schemas\step-registry.schema.json" LogicalName="DesktopAutomationAgent.Compilation.step-registry.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DesktopAutomationAgent.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
