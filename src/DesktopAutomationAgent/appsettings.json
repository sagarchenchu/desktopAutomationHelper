{
  "Driver": {
    "VerifyUrl": "http://localhost:9102/verify",
    "RequestTimeoutSeconds": 20,
    "ExpectedCatalogSchemaVersion": 2,
    "AllowRemoteDriver": false
  },
  "Workspace": {
    "Root": "automation"
  },
  "Suites": {
    "JiraKeyPattern": "^[A-Z][A-Z0-9_]{0,31}-[1-9][0-9]{0,15}$"
  },
  "Runner": {
    "StepTransportTimeoutSeconds": 60,
    "CleanupTimeoutSeconds": 15,
    "MaxPlanBytes": 1048576,
    "MaxResponseBytes": 10485760,
    "RegexTimeoutMilliseconds": 500
  },
  "ObjectRepository": {
    "MaxFileBytes": 5242880,
    "MaxPages": 500,
    "MaxElementsPerPage": 5000,
    "MaxTotalElements": 50000,
    "DiagnosticTimeoutMilliseconds": 15000
  },
  "Knowledge": {
    "MaxFileBytes": 10485760,
    "MaxExplorationRuns": 500
  },
  "Jira": {
    "AuthMode": "basic",
    "MappingProfile": "plain-fields",
    "RequestTimeoutSeconds": 30,
    "MaxResponseBytes": 2097152,
    "MaxRetries": 2,
    "PageSize": 50,
    "MaxPages": 20,
    "SearchPagination": "jql-token",
    "AllowLocalHttpTestServer": false
  },
  "Planning": {
    "Provider": "fake",
    "DefaultApprovalMode": "proposal-only",
    "RequestTimeoutSeconds": 30,
    "MaxPromptTokens": 4000,
    "MaxCompletionTokens": 2000,
    "MaxOutputBytes": 65536,
    "MaxRetrievalHits": 40,
    "MaxUntrustedContextChars": 4000,
    "AllowOptionalEmbeddings": false
  },
  "Recovery": {
    "Enabled": true,
    "AllowMutationReplay": false,
    "MaxTotalRecoveriesPerRun": 12,
    "MaxRecoveryAttemptsPerStep": 8,
    "MaxAdditionalDurationSeconds": 60,
    "BoundedWaitMilliseconds": 750,
    "MaxCandidateArtifactBytes": 65536,
    "Provider": "fake"
  },
  "Vision": {
    "Enabled": false,
    "AllowWhenUiaInaccessible": true,
    "AllowWhenPolicyPermits": false,
    "MaxScreenshotAgeMilliseconds": 1500,
    "PersistSensitiveScreenshots": false,
    "Provider": "fake",
    "MinimumConfidence": 0.6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning"
    }
  }
}
