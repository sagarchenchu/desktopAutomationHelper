{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/desktop-automation-agent/application-knowledge.schema.json",
  "title": "ApplicationKnowledge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledgeSchemaVersion",
    "knowledgeId",
    "applicationId",
    "buildFingerprint",
    "fingerprint",
    "status",
    "createdAtUtc",
    "sourceExplorationRuns",
    "graph",
    "coverage"
  ],
  "properties": {
    "knowledgeSchemaVersion": { "const": 1 },
    "knowledgeId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "applicationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "buildFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{16,64}$"
    },
    "fingerprint": { "$ref": "#/$defs/applicationFingerprint" },
    "status": {
      "type": "string",
      "enum": ["candidate", "approved"]
    },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "updatedAtUtc": { "type": "string", "format": "date-time" },
    "sourceExplorationRuns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/sourceExplorationRun" }
    },
    "graph": { "$ref": "application-state-graph.schema.json" },
    "workflows": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "application-workflow.schema.json" }
    },
    "coverage": { "$ref": "#/$defs/coverageReport" },
    "idCollisions": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/idCollision" }
    },
    "approval": { "$ref": "knowledge-approval.schema.json" },
    "warnings": {
      "type": "array",
      "maxItems": 500,
      "items": { "type": "string", "maxLength": 2000 }
    }
  },
  "$defs": {
    "applicationFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationId",
        "snapshotSchemaVersion",
        "explorerVersion",
        "explorationPolicyHash"
      ],
      "properties": {
        "applicationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "executablePath": { "type": ["string", "null"], "maxLength": 1024 },
        "productVersion": { "type": ["string", "null"], "maxLength": 128 },
        "fileVersion": { "type": ["string", "null"], "maxLength": 128 },
        "executableSha256": {
          "type": ["string", "null"],
          "pattern": "^([a-f0-9]{64})?$"
        },
        "configIdentity": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          },
          "propertyNames": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "maxProperties": 64
        },
        "driverVersion": { "type": ["string", "null"], "maxLength": 128 },
        "snapshotSchemaVersion": { "type": "integer", "const": 1 },
        "explorerVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "explorationPolicyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sourceExplorationRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explorationId", "artifactHash", "policySha256"],
      "properties": {
        "explorationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "artifactHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "manifestPath": { "type": ["string", "null"], "maxLength": 1024 }
      }
    },
    "coverageReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows",
        "uniqueStates",
        "actionableElements",
        "permittedTransitionsAttempted",
        "successfulTransitions",
        "noOpTransitions",
        "failedTransitions",
        "deniedSamples",
        "unresolvedElements",
        "conflicts",
        "truncationOrBudgetLimits"
      ],
      "properties": {
        "windows": { "type": "integer", "minimum": 0 },
        "uniqueStates": { "type": "integer", "minimum": 0 },
        "actionableElements": { "type": "integer", "minimum": 0 },
        "permittedTransitionsAttempted": { "type": "integer", "minimum": 0 },
        "successfulTransitions": { "type": "integer", "minimum": 0 },
        "noOpTransitions": { "type": "integer", "minimum": 0 },
        "failedTransitions": { "type": "integer", "minimum": 0 },
        "deniedSamples": { "type": "integer", "minimum": 0 },
        "unresolvedElements": { "type": "integer", "minimum": 0 },
        "conflicts": { "type": "integer", "minimum": 0 },
        "truncationOrBudgetLimits": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "idCollision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stableId", "leftKey", "rightKey"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["window", "state", "element", "transition", "workflow"]
        },
        "stableId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "leftKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "rightKey": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  }
}
