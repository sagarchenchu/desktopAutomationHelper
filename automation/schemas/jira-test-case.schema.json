{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktopautomationhelper.local/schemas/jira-test-case.schema.json",
  "title": "Offline Jira test-case export (Phase 4D)",
  "$comment": "Offline artifact only. No credentials, secrets, or raw production data. Either feature (Gherkin text) or structured scenarios must be present. revision or updatedAt must be present.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jiraKey", "summary"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "maxLength": 512 },
    "schemaVersion": { "type": "integer", "const": 1 },
    "jiraKey": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,31}-[1-9][0-9]{0,15}$",
      "maxLength": 64
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
    "description": { "type": "string", "maxLength": 8192 },
    "feature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "background": { "$ref": "#/$defs/structuredBackground" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/structuredScenario" }
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "testDataRefs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9_./-]+$"
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        { "required": ["feature"] },
        { "required": ["scenarios"] }
      ]
    },
    {
      "anyOf": [
        { "required": ["revision"] },
        { "required": ["updatedAt"] }
      ]
    }
  ],
  "$defs": {
    "stepKeyword": {
      "type": "string",
      "enum": ["Given", "When", "Then", "And", "But"]
    },
    "structuredStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyword", "text"],
      "properties": {
        "keyword": { "$ref": "#/$defs/stepKeyword" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "structuredBackground": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "name": { "type": "string", "maxLength": 256 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/structuredStep" }
        }
      }
    },
    "structuredScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/structuredStep" }
        }
      }
    }
  }
}
