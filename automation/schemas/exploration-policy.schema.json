{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/desktop-automation-agent/exploration-policy.schema.json",
  "title": "DesktopAutomationAgent Exploration Policy",
  "$comment": "Phase 4B deny-by-default policy. Modes are observe and navigate only. Invoke/click is never implied by pattern presence alone.",
  "type": "object",
  "required": [
    "policySchemaVersion",
    "mode",
    "application",
    "scope",
    "allowedActionCategories",
    "allowRules",
    "denyRules",
    "budgets",
    "allowCloseChildWindowsForBacktrack",
    "allowHover",
    "allowCoordinateFallback"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "policySchemaVersion": {
      "const": 1
    },
    "policyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mode": {
      "type": "string",
      "enum": ["observe", "navigate"]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processName"],
      "properties": {
        "processName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "executablePath": {
          "type": ["string", "null"],
          "maxLength": 1024
        },
        "executableSha256": {
          "type": ["string", "null"],
          "pattern": "^([a-fA-F0-9]{64})?$"
        },
        "allowedChildProcessNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windowsSessionId": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "allowedWindowTitles": {
          "type": "array",
          "items": { "type": "string", "maxLength": 256 },
          "maxItems": 64
        },
        "deniedWindowTitles": {
          "type": "array",
          "items": { "type": "string", "maxLength": 256 },
          "maxItems": 64
        },
        "allowedWindowClasses": {
          "type": "array",
          "items": { "type": "string", "maxLength": 256 },
          "maxItems": 64
        },
        "deniedWindowClasses": {
          "type": "array",
          "items": { "type": "string", "maxLength": 256 },
          "maxItems": 64
        }
      }
    },
    "allowedActionCategories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "expandCollapse",
          "tabSelect",
          "menuOpen",
          "scroll",
          "focus",
          "hover",
          "selectItem",
          "invoke"
        ]
      },
      "uniqueItems": true,
      "maxItems": 16
    },
    "allowRules": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/elementActionRule" }
    },
    "denyRules": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/elementActionRule" }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxStates",
        "maxActions",
        "maxDepth",
        "totalDurationSeconds",
        "perActionTimeoutSeconds",
        "stabilizationTimeoutSeconds"
      ],
      "properties": {
        "maxStates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxActions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "totalDurationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "perActionTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "stabilizationTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "stabilizationQuietPeriodMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 400
        }
      }
    },
    "allowCloseChildWindowsForBacktrack": {
      "type": "boolean"
    },
    "allowHover": {
      "type": "boolean"
    },
    "allowCoordinateFallback": {
      "type": "boolean",
      "$comment": "Default false. Coordinate clicks are deny-by-default."
    },
    "allowDoubleClick": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "elementActionRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automationId": {
          "type": "string",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "nameContains": {
          "type": "string",
          "maxLength": 256
        },
        "controlType": {
          "type": "string",
          "maxLength": 64
        },
        "className": {
          "type": "string",
          "maxLength": 256
        },
        "action": {
          "type": "string",
          "enum": [
            "expand",
            "collapse",
            "tabSelect",
            "menuOpen",
            "scroll",
            "focus",
            "hover",
            "selectItem",
            "invoke",
            "*"
          ]
        },
        "actionCategory": {
          "type": "string",
          "enum": [
            "expandCollapse",
            "tabSelect",
            "menuOpen",
            "scroll",
            "focus",
            "hover",
            "selectItem",
            "invoke",
            "*"
          ]
        }
      }
    }
  }
}
