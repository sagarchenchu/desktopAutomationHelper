{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktopautomationhelper.local/schemas/step-registry.schema.json",
  "title": "Deterministic BDD step registry (Phase 4D)",
  "$comment": "Maps exact or bounded-regex step text to Phase 2 plan-step templates. Regex patterns are culture-invariant and timeout-bounded at compile time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "version", "mappings"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "maxLength": 512 },
    "schemaVersion": { "type": "integer", "const": 1 },
    "registryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "name": { "type": "string", "maxLength": 256 },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._+-]+$"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingId",
        "pattern",
        "keywords",
        "planSteps",
        "risk",
        "source",
        "version",
        "approval"
      ],
      "properties": {
        "mappingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "pattern": { "$ref": "#/$defs/pattern" },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["Given", "When", "Then"]
          }
        },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "planSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/planStepTemplate" }
        },
        "approvedObjectRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}\\.[a-z][a-z0-9-]{0,63}$"
          }
        },
        "approvedKnowledgeRefs": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/knowledgeRef" }
        },
        "expectedState": { "type": ["string", "null"], "maxLength": 256 },
        "postcondition": { "type": ["string", "null"], "maxLength": 512 },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "prohibited"]
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._+-]+$"
        },
        "approval": { "$ref": "#/$defs/approval" }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "enum": ["exact", "regex"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": ["string", "int", "bool", "objectRef"]
        }
      }
    },
    "planStepTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idTemplate", "operation", "arguments"],
      "properties": {
        "idTemplate": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "type": "string", "minLength": 1, "maxLength": 128 },
        "arguments": { "type": "object" },
        "assertions": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "object" }
        },
        "sensitive": { "type": "boolean" },
        "captureResponse": { "type": "boolean" }
      }
    },
    "knowledgeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["state", "transition", "workflow", "element", "window"]
        },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": {
          "type": "string",
          "enum": ["navigation", "expectedState", "postcondition"],
          "default": "navigation"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedBy", "approvedAt"],
      "properties": {
        "approvedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "approvedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 1024 }
      }
    }
  }
}
