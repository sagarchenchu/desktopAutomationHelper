{
  "policySchemaVersion": 1,
  "policyId": "acceptance-second-window-crawl",
  "mode": "navigate",
  "application": {
    "processName": "DesktopAutomationExplorerFixture",
    "allowedChildProcessNames": []
  },
  "scope": {
    "allowedWindowTitles": [
      "DA Explorer Fixture",
      "DA Explorer Second"
    ],
    "deniedWindowTitles": [],
    "allowedWindowClasses": [],
    "deniedWindowClasses": []
  },
  "allowedActionCategories": ["invoke"],
  "allowRules": [
    {
      "automationId": "ExplorerOpenSecondButton",
      "action": "invoke",
      "actionCategory": "invoke"
    },
    {
      "automationId": "ExplorerSecondPingButton",
      "action": "invoke",
      "actionCategory": "invoke"
    }
  ],
  "denyRules": [
    { "automationId": "ExplorerDeleteButton", "action": "*" },
    { "nameContains": "Delete", "action": "*" }
  ],
  "budgets": {
    "maxStates": 12,
    "maxActions": 10,
    "maxDepth": 4,
    "totalDurationSeconds": 120,
    "perActionTimeoutSeconds": 15,
    "stabilizationTimeoutSeconds": 8,
    "stabilizationQuietPeriodMilliseconds": 400
  },
  "allowCloseChildWindowsForBacktrack": true,
  "allowHover": false,
  "allowCoordinateFallback": false,
  "allowDoubleClick": false
}
